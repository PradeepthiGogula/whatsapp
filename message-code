<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WhatsApp Integration</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #f0f0f0;
        }
        .whatsapp-button {
            background-color: #25D366;
            color: white;
            padding: 15px 25px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            text-decoration: none;
        }
        .whatsapp-button:hover {
            background-color: #128C7E;
        }
    </style>
</head>
<body>
    <a href="https://wa.me/1234567890" class="whatsapp-button" target="_blank">Chat with us on WhatsApp</a>

    <script>
        document.querySelector('.whatsapp-button').addEventListener('click', function() {
            console.log('WhatsApp button clicked');
        });
    </script>
</body>
</html>
